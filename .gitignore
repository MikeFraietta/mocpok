# Generated games (each run writes a new folder here)
projects/
# Local rulebook search index (built from third-party rule text; rebuild locally)
library.sqlite3
.library-*.sqlite3
__pycache__/
*.pyc
.DS_Store

# Rules corpus: commit only the scripts and metadata manifests, never collected rule text
rules-corpus/corpus/*
!rules-corpus/corpus/manifest.jsonl
!rules-corpus/corpus/manifests/
rules-corpus/raw/
rules-corpus/.venv/
rules-corpus/*.jsonl
